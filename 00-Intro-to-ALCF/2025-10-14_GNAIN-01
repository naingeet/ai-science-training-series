from mpi4py import MPI

def get_local_rank():
    comm = MPI.COMM_WORLD
    local_comm = comm.Split_type(MPI.COMM_TYPE_SHARED)
    return local_comm.Get_rank()

LOCAL_RANK = get_local_rank()


